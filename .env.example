# --- LLM (script generation) --------------------------------------------
# These are the server's DEFAULT provider keys, used for any user who has
# not set their own under the app's Settings > API Keys page. Leaving all
# of these blank is fine -- every logged-in user can supply their own keys
# instead (encrypted at rest, see CREDENTIALS_ENCRYPTION_KEY below).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_MODEL_FALLBACKS=openai/gpt-4o,google/gemini-1.5-pro

# --- Stock footage (server defaults; users can override in Settings) -----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Text to speech (server defaults; users can override in Settings) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Object storage, Cloudflare R2 (server defaults; users can override) -
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Data stores -----------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/video_builder
REDIS_URL=redis://localhost:6379

# --- Auth --------------------------------------------------------------
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Master key that encrypts every user's own provider API keys at rest
# (AES-256-GCM). Required by both apps/api and apps/worker, and both MUST
# use the exact same value or neither can decrypt the other's writes.
# Generate one with:
#   openssl rand -base64 32
# Losing/rotating this key makes every already-stored user key permanently
# undecryptable -- back it up somewhere safe (a secrets manager, not git).
CREDENTIALS_ENCRYPTION_KEY=

# --- App -----------------------------------------------------------------
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
