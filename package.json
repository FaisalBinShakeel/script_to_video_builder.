{
  "name": "script-to-video-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "pnpm -r --filter=./packages/* build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "script:gen": "pnpm --filter @video-builder/core script:gen",
    "footage:test": "pnpm --filter @video-builder/core footage:test",
    "voice:test": "pnpm --filter @video-builder/core voice:test",
    "video:render": "pnpm --filter @video-builder/video video:render",
    "video:studio": "pnpm --filter @video-builder/video studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
